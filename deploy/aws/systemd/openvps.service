[Unit]
Description=OpenVPS compose stack
Requires=docker.service
# After the identity provider: the apps should not start against a dead issuer.
After=docker.service network-online.target home-ubuntu-data.mount openvps-auth.service
Wants=network-online.target openvps-auth.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/openvps/openvps
# COMPOSE_FILES holds the -f flags for this deployment's variant, written by user-data.
# Unquoted $COMPOSE_FILES is word-split by systemd, which is what turns one value back into
# a flag list — so the unit stays identical across variants and the variant lives in one
# place. ${COMPOSE_FILES} (braced) would NOT split, and the command would fail.
EnvironmentFile=/opt/openvps/compose.conf
ExecStartPre=/usr/local/bin/openvps-render-env
ExecStart=/usr/bin/docker compose $COMPOSE_FILES --env-file /opt/openvps/docker.env up -d --wait --wait-timeout 600
ExecStop=/usr/bin/docker compose $COMPOSE_FILES --env-file /opt/openvps/docker.env stop
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
