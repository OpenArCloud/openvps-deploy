<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright 2026 Open AR Cloud. MIT. SPDX-License-Identifier: MIT

  Cyclone DDS config for the spatialdds variant. Rendered at boot to cyclonedds.xml, with
  the PEERS marker below replaced by one Peer element per address in the DdsPeers stack
  parameter.

  Multicast is off because an AWS VPC does not carry it. Cyclone discovers by multicast by
  default, so leaving it on gives a deployment that works on a laptop, works on one
  instance over loopback, and silently finds nothing across two - an absence of peers
  rather than an error. Discovery is unicast against the peer list instead; empty is right
  for a single host, where ParticipantIndex=auto probes the local port range.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers><!--PEERS--></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
